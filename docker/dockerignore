# ============================================================
# .dockerignore — files excluded from the Docker build context
# ============================================================

# ----- Secrets & environment -----
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.crt

# ----- Python cache -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ----- Virtual environments -----
.venv/
venv/
env/
ENV/

# ----- Jupyter notebooks -----
*.ipynb
.ipynb_checkpoints/

# ----- Raw & processed data (never baked into the image) -----
data/raw/
data/processed/
*.csv
*.parquet
*.json
*.xlsx
*.xls

# ----- Logs -----
logs/
*.log

# ----- Version control -----
.git/
.gitignore
.github/

# ----- IDE & OS artefacts -----
.idea/
.vscode/
*.DS_Store
Thumbs.db

# ----- Documentation -----
docs/
*.md
!README.md

# ----- Tests -----
tests/
.pytest_cache/
htmlcov/
.coverage
