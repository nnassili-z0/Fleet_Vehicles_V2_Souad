# ============================================================
# .env.example — Environment Configuration Template
# ============================================================
# Copy to .env and fill in actual values for your environment
#
# DO NOT commit .env to version control
# DO NOT use default values in production

# ============================================================
# Environment
# ============================================================
ENV=development
# Options: development, staging, production

# ============================================================
# Database Configuration
# ============================================================
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fleet_vehicles
DB_USER=airflow
DB_PASSWORD=airflow

# ============================================================
# Data Quality Configuration
# ============================================================
QUALITY_VALIDATION_ENABLED=true
ANOMALY_DETECTION_ENABLED=true
OUTLIER_THRESHOLD_PERCENTILE=0.5
MAX_NULL_PERCENTAGE=10.0
QUALITY_CHECKPOINT_ENABLED=true

# ============================================================
# Pipeline Batch Sizes
# ============================================================
# Adjust based on available memory and data volume
BRONZE_TO_SILVER_BATCH_SIZE=10000
SILVER_TO_GOLD_BATCH_SIZE=50000

# ============================================================
# Logging
# ============================================================
LOGGING_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
