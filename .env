# ============================================================
# .env.example — copy to .env and fill in your values
# NEVER commit the real .env file to version control
# ============================================================

# ----- PostgreSQL -----
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=airflow

# ----- Airflow security keys -----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=your_secret_key_here

# ----- Airflow admin account -----
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

